{
    "name": "velirapay/velirapay-woocommerce",
    "description": "The official VeliraPay payment gateway for WooCommerce: take Bitcoin, Ethereum, USDC and other coins at checkout.",
    "type": "wordpress-plugin",
    "keywords": [
        "velirapay",
        "woocommerce",
        "wordpress",
        "crypto",
        "payments",
        "payment-gateway",
        "bitcoin",
        "ethereum",
        "webhooks"
    ],
    "homepage": "https://velirapay.com",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "VeliraPay",
            "homepage": "https://velirapay.com"
        }
    ],
    "support": {
        "docs": "https://velirapay.com/docs",
        "issues": "https://github.com/VeliraPay/velirapay-woocommerce/issues",
        "source": "https://github.com/VeliraPay/velirapay-woocommerce"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "php-stubs/woocommerce-stubs": "^8.3 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.3 || ^13.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "VeliraPay\\WooCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeliraPay\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test",
        "types": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@types",
            "@test"
        ],
        "build": "bash bin/build.sh"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
